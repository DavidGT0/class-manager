{
  "name": "class-manager",
  "version": "1.0.0",
  "description": "Class management system - CRUD for students (Node + Express + PostgreSQL), deployable to Vercel",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "dev:memory": "node scripts/memory-postgres.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-socket": "^0.2.20",
    "supertest": "^7.3.2"
  }
}
